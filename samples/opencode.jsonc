{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "snapshot": false,
  "agent": {
    "title": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low",
      "prompt": "根据用户输入生成标题: 使用简体中文,专业术语除外,尽量不超过15个字,不要加引号/冒号/句号,不要解释原因,只输出标题本身",
      "mode": "primary",
      "options": {},
      "permission": {}
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "面向用户的输出使用中文（包括：解释、总结、问题选项说明、TodoWrite 里的 todos.content）。仅专有名词保留原样；",
      "options": {},
      "permission": {}
    },
    "build": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "面向用户的输出使用中文（包括：解释、总结、问题选项说明、TodoWrite 里的 todos.content）。仅专有名词保留原样；",
      "mode": "primary",
      "options": {},
      "permission": {}
    },
    "explore": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "mode": "subagent",
      "options": {},
      "permission": {}
    }
  },
  "permission": {
    "generate_image": {
      "openai/*": "allow"
    },
    "external_directory": {
      "~/**": "allow"
    },
    "edit": {
      "~/**": "ask"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome"
      ],
      "enabled": false
    }
  },
  "provider": {
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "http://192.168.2.110:8080/v1",
        "apiKey": "",
        "setCacheKey": true
      },
      "whitelist": [
        "claude-sonnet-4-6",
        "claude-opus-4-6",
        "claude-opus-4-7",
        "claude-opus-4-8",
        "claude-sonnet-5"
      ]
    },
    "openai": {
      "options": {
        "baseURL": "http://192.168.2.110:8080/v1",
        "apiKey": "",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ]
      },
      "whitelist": [
        "gpt-5.5",
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "gpt-5.6-luna",
        "gpt-image-2"
      ],
      "models": {
        "gpt-image-2": {
          "limit": {
            "context": 128000,
            "input": 128000,
            "output": 64000
          },
          "options": {
            "imageApi": "openai-compatible",
            "defaultForImageGeneration": true
          }
        },
        "gpt-5.5": {
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          }
        },
        "gpt-5.6-sol": {
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 64000
          }
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 64000
          }
        },
        "gpt-5.6-luna": {
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 64000
          }
        }
      }
    },
    "opencode-go": {
      "options": {
        "baseURL": "http://192.168.2.110:8080/v1",
        "apiKey": ""
      },
      "whitelist": [
        "deepseek-v4-flash",
        "deepseek-v4-pro"
      ]
    }
  },
  "shell": "powershell"
}