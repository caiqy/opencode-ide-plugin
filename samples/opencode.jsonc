{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "snapshot": false,
  "image_model": "openai/gpt-image-2",
  "agent": {
    "title": {
      "model": "openai/gpt-5.4-mini",
      "variant": "low",
      "prompt": "根据用户输入生成标题: 使用简体中文,专业术语除外,尽量不超过15个字,不要加引号/冒号/句号,不要解释原因,只输出标题本身",
      "mode": "primary",
      "options": {},
      "permission": {},
    },
    "plan": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "prompt": "面向用户的输出使用中文（包括：解释、总结、问题选项说明、TodoWrite 里的 todos.content）。仅专有名词保留原样；",
      "options": {},
      "permission": {},
    },
    "build": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "prompt": "面向用户的输出使用中文（包括：解释、总结、问题选项说明、TodoWrite 里的 todos.content）。仅专有名词保留原样；",
      "mode": "primary",
      "options": {},
      "permission": {},
    },
    "explore": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "mode": "subagent",
      "options": {},
      "permission": {},
    },
  },
  "permission": {
    "generate_image": {
      "openai/*": "allow",
    },
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "chrome"],
      "enabled": false,
    },
  },
  "provider": {
    "anthropic": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "http://192.168.2.110:8080/v1",
        "apiKey": "",
        "setCacheKey": true,
      },
      "whitelist": ["claude-sonnet-4-6", "claude-opus-4-6", "claude-opus-4-7", "claude-opus-4-8"],
    },
    "openai": {
      "options": {
        "baseURL": "http://192.168.2.110:8080/v1",
        "apiKey": "",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": ["reasoning.encrypted_content"],
      },
      "whitelist": ["gpt-5.3-codex-spark", "gpt-5.4-mini", "gpt-5.4", "gpt-5.5", "gpt-image-2"],
      "models": {
        "gpt-image-2": {
          "limit": {
            "context": 128000,
            "input": 128000,
            "output": 64000,
          },
          "options": {
            "imageApi": "openai-compatible",
          },
        },
        "gpt-5.5": {
          "limit": {
            "context": 400000,
            "input": 272000,
            "output": 128000,
          },
        },
      },
    },
    "opencode-go": {
      "options": {
        "baseURL": "http://192.168.2.110:8080/v1",
        "apiKey": "",
      },
      "whitelist": ["deepseek-v4-flash", "deepseek-v4-pro", "mimo-v2.5", "mimo-v2.5-pro", "glm-5.2"],
      "models": {
        "mimo-v2.5": {
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "mimo-v2.5-pro": {
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "shell": "powershell",
}
